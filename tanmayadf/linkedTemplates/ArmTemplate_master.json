{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "tanmayadf"
		},
		"ADLS_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_LS'"
		},
		"AzureSqlDatabase_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase_LS'"
		},
		"ADLS_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdheeraj.dfs.core.windows.net/"
		},
		"AzureDatabricks_LS_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0429-052202-v4b6vafv"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dheeserver.database.windows.net"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-1642571"
		},
		"AzureSqlDatabase_LS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dheeraj"
		},
		"LS_practice_sasUri": {
			"type": "secureString",
			"metadata": "Secure string for 'sasUri' of 'LS_practice'"
		},
		"keyvault_LS_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://vaultdheeraj.vault.azure.net/"
		},
		"trigger1_storage_event_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/6c5b2a56-8d05-4dc4-81cd-4851419424f2/resourceGroups/Resource_dheeraj/providers/Microsoft.Storage/storageAccounts/adlsdheeraj"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "tanmayadf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADLS_LS_accountKey": {
						"value": "[parameters('ADLS_LS_accountKey')]"
					},
					"AzureSqlDatabase_LS_password": {
						"value": "[parameters('AzureSqlDatabase_LS_password')]"
					},
					"ADLS_LS_properties_typeProperties_url": {
						"value": "[parameters('ADLS_LS_properties_typeProperties_url')]"
					},
					"AzureDatabricks_LS_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks_LS_properties_typeProperties_existingClusterId')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase_LS_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase_LS_properties_typeProperties_userName')]"
					},
					"LS_practice_sasUri": {
						"value": "[parameters('LS_practice_sasUri')]"
					},
					"keyvault_LS_properties_typeProperties_baseUrl": {
						"value": "[parameters('keyvault_LS_properties_typeProperties_baseUrl')]"
					},
					"trigger1_storage_event_properties_typeProperties_scope": {
						"value": "[parameters('trigger1_storage_event_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}